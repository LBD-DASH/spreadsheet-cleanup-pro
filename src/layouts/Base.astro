---
import '../styles/global.css';
import { withBase, absUrl, SITE_NAME, CTA } from '../lib/url';
interface Props { title: string; description: string; path: string; jsonLd?: object[]; ogType?: string; }
const { title, description, path, jsonLd = [], ogType = 'website' } = Astro.props;
const canonical = absUrl(path, Astro.site);
const fullTitle = title.includes(SITE_NAME) ? title : `${title} | ${SITE_NAME}`;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#0b3d2a" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="robots" content="index, follow" />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary" />
    <link rel="icon" type="image/svg+xml" href={withBase('favicon.svg')} />
    <link rel="sitemap" href={withBase('sitemap.xml')} />
    {jsonLd.map((obj) => <script type="application/ld+json" set:html={JSON.stringify(obj)} />)}
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header class="site-header">
      <div class="wrap">
        <a class="brand" href={withBase('')}><img src={withBase('favicon.svg')} alt="" width="28" height="28" />{SITE_NAME}</a>
        <nav class="site-nav" aria-label="Main">
          <a href={withBase('services/')}>Services</a>
          <a href={withBase('how-it-works/')}>How it works</a>
          <a href={withBase('faq/')}>FAQ</a>
          <a href={withBase('about/')}>About</a>
          <a class="btn" href={withBase('request-a-quote/')}>{CTA}</a>
        </nav>
      </div>
    </header>
    <main id="main"><slot /></main>
    <footer class="site-footer">
      <div class="wrap">
        <p>{SITE_NAME} is an AI-assisted data cleanup and reporting service for small firms. This site makes no promises about outcomes; scope and terms are agreed in writing with each client.</p>
        <ul class="foot-links">
          <li><a href={withBase('privacy/')}>Privacy</a></li>
          <li><a href={withBase('disclosure/')}>Disclosure</a></li>
          <li><a href={withBase('about/')}>About</a></li>
          <li><a href={withBase('sitemap.xml')}>Sitemap</a></li>
        </ul>
        <p>&copy; {new Date().getFullYear()} {SITE_NAME}.</p>
      </div>
    </footer>
  </body>
</html>
